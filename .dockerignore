# Only reviewed application/build inputs enter the root image context.
# Documentation, operator configuration, SQL data and agent state stay outside.
**
!Dockerfile
!package.json
!package-lock.json
!.npmrc
!next.config.ts
!tsconfig.json
!postcss.config.mjs
!src/
!src/**
!public/
!public/**
!vendor/
!vendor/**
!scripts/
!scripts/check-install-scripts.mjs
!scripts/install-dependencies.mjs
!deploy/
!deploy/self-host/
!deploy/self-host/*.mjs
!deploy/self-host/start.sh

# Deny sensitive/artifact names even inside an allowed source directory.
# Version-control and local runtime state
.git
.git/**
.env
.env.*
**/.env
**/.env.*
*.env
*.env.*
**/*.env
**/*.env.*

# Dependency, build, and test artifacts
node_modules
node_modules/**
.next
.next/**
.next-e2e
.next-e2e/**
.next-perf-review
.next-perf-review/**
coverage
coverage/**
playwright-report
playwright-report/**
test-results
test-results/**
.tmp
.tmp/**
out
out/**
build
build/**

# Credentials, private keys, backups, and ad-hoc deployment state
*.pem
**/*.pem
*.key
**/*.key
*.crt
**/*.crt
*.p12
**/*.p12
*.pfx
**/*.pfx
*.bak
**/*.bak
*.backup
**/*.backup
*.dump
**/*.dump
*.sqlite
**/*.sqlite
*.sql.gz
**/*.sql.gz
secrets
secrets/**
credentials
credentials/**
keys
keys/**
backups
backups/**
deploy/self-host/runtime.env
