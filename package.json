{
  "name": "ssartnership",
  "version": "1.11.6",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.1",
    "npm": ">=11.12.1 <12"
  },
  "allowScripts": {
    "esbuild@0.28.1": false,
    "unrs-resolver": false
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "node scripts/dev.mjs",
    "check:cross-platform": "node scripts/check-cross-platform.mjs",
    "check:install-scripts": "node scripts/check-install-scripts.mjs",
    "install:trusted": "node scripts/install-dependencies.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "build": "next build --webpack",
    "typecheck:ci": "node scripts/typecheck-ci.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "node scripts/run-package-scripts.mjs test:node test:unit",
    "test:node": "node --import ./tests/alias-register.mjs --test tests/*.test.mts tests/push/*.test.mts",
    "test:unit": "vitest run --project=unit --coverage",
    "test-storybook": "vitest run --project=storybook --reporter=default --reporter=hanging-process",
    "test-storybook:watch": "vitest --project=storybook",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "ci:local": "node scripts/run-package-scripts.mjs bootstrap check:cross-platform check:lockfile lint typecheck:ci test build build-storybook test-storybook test:visual",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node scripts/run-e2e-ci.mjs",
    "prepush": "node scripts/run-package-scripts.mjs check:install-scripts check:cross-platform check:lockfile test:e2e:ci",
    "sync:preview": "node scripts/supabase-sync-preview.mjs",
    "migrate:legacy-member-avatars": "node --import ./tests/alias-register.mjs --env-file-if-exists=.env scripts/migrate-legacy-member-avatars.mjs",
    "migrate:image-assets": "node --import ./tests/alias-register.mjs --env-file-if-exists=.env scripts/migrate-image-assets.mts",
    "rss:refresh": "node scripts/refresh-rss.mjs",
    "perf:lighthouse": "node scripts/run-package-scripts.mjs build perf:lighthouse:run",
    "perf:lighthouse:run": "node scripts/lighthouse-check.mjs",
    "test:mm-profile": "node --import ./tests/alias-register.mjs --test tests/mm-profile-csv.test.mts",
    "test:partner-portal": "node --import ./tests/alias-register.mjs --test tests/partner-portal.mock.test.mts",
    "test:ssafy-cycle": "node --import ./tests/alias-register.mjs --test tests/ssafy-cycle-simulation.test.mts",
    "validate:migrations": "node scripts/validate-supabase-migrations.mjs",
    "audit:security": "node scripts/security-audit.mjs",
    "bootstrap:super-admin": "node scripts/bootstrap-super-admin.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@discourse/heic": "1.0.0",
    "@heroicons/react": "^2.2.0",
    "@supabase/supabase-js": "^2.99.0",
    "@types/qrcode": "^1.5.6",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "archiver-core": "npm:archiver@8.0.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "marked": "^18.0.6",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^6.1.0",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/nextjs-vite": "^10.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-storybook": "10.3.5",
    "lighthouse": "^13.4.1",
    "playwright": "^1.59.1",
    "postcss": "^8.5.23",
    "storybook": "^10.3.5",
    "tailwindcss": "^4",
    "typescript": "5.6.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "archiver": "file:vendor/archiver-cjs-compat",
    "esbuild": "^0.28.1",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "sharp": "$sharp",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.4": {
      "brace-expansion": "5.0.9"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "exceljs": {
      "unzipper": "^0.12.5"
    },
    "postcss": "^8.5.23",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "vite": "^8.0.16",
    "ws": "^8.21.0"
  }
}
