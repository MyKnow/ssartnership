[Unit]
Description=SSARTNERSHIP bounded Preview maintenance %i
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
Nice=10
TimeoutStartSec=30min
ExecStart=/opt/ssartnership/control/current/deploy/self-host-ci/maintenance-run.sh %i
# The Docker daemon and exec'd backup processes are outside this unit's cgroup.
# A timeout is an incident requiring the runbook's lock/writer recovery check,
# never permission to restart writers or discard a stale lock automatically.
