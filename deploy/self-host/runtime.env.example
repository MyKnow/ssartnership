# Copy this file to deploy/self-host/runtime.env, replace every placeholder,
# and restrict its permissions. The copied runtime.env is ignored by Git.
#
# These public values are build arguments and MUST exactly match the image's
# build manifest. They are intentionally not secrets.
NEXT_PUBLIC_DATA_SOURCE=supabase
NEXT_PUBLIC_PARTNER_PORTAL_DATA_SOURCE=supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:58000
NEXT_PUBLIC_SITE_URL=https://app.example.invalid
# Leave empty only when browser push is intentionally disabled at build time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Self-hosted real mode validates all fields below before starting Next.
# SUPABASE_URL is the externally reachable origin used by the Supabase SDK.
# It MUST equal NEXT_PUBLIC_SUPABASE_URL so generated Storage signed URLs stay
# browser-reachable. SUPABASE_INTERNAL_URL is optional and only routes server
# SDK fetches through the private Compose gateway.
SUPABASE_URL=http://127.0.0.1:58000
SUPABASE_INTERNAL_URL=http://gateway:8000
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
USER_SESSION_SECRET=replace-with-at-least-32-random-characters
PARTNER_SESSION_SECRET=replace-with-at-least-32-random-characters
CERTIFICATION_QR_SECRET=replace-with-at-least-32-random-characters
MEMBER_IDENTIFIER_RESERVATION_HMAC_SECRET=replace-with-at-least-32-random-characters
MEMBER_EMAIL_VERIFICATION_HMAC_SECRET=replace-with-at-least-32-random-characters
GRADUATE_VERIFICATION_HMAC_SECRET=replace-with-at-least-32-random-characters
MM_BASE_URL=https://mattermost.example.invalid
MM_SENDER_CREDENTIALS_ACTIVE_KEY_VERSION=1
# Exactly 32 decoded bytes; standard base64 and base64url are both accepted.
MM_SENDER_CREDENTIALS_KEY_V1=replace-with-32-byte-base64-key
CRON_SECRET=replace-with-at-least-32-random-characters

# Process defaults are not set in this file. Both app images default TZ to
# Asia/Seoul and KEEP_ALIVE_TIMEOUT to 130000 ms, and the PVE Compose overlays
# pin the same values over this env file. Startup validation rejects any other
# TZ and a KEEP_ALIVE_TIMEOUT at or below the relay Caddy's 2m idle upstream
# keepalive, because Caddy could reuse a socket Node already closed. A runner
# that does not use these images must export the same two values itself.
# ---------------------------------------------------------------------------
# Optional runtime settings. Uncomment only the features this environment uses.
# The canonical list and tiers live in scripts/lib/env-manifest.mjs; run
# `npm run check:env` after editing. Legacy aliases (NAVER_SMTP_*,
# DATA_GO_KR_SERVICE_KEY) are intentionally not listed.
# ---------------------------------------------------------------------------

# Purpose-separated secrets. When unset they fall back to USER_SESSION_SECRET
# (or ADMIN_SESSION_SECRET for the partner preview token).
# RESET_PASSWORD_SESSION_SECRET=replace-with-at-least-32-random-characters
# MANUAL_MEMBER_IMPORT_TOKEN_SECRET=replace-with-at-least-32-random-characters
# PARTNER_PREVIEW_TOKEN_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
# ADMIN_SESSION_TTL_HOURS=12

# Admin edge protection. Set ADMIN_ALLOWED_IPS only after the trusted proxy
# client IP contract is verified for this environment.
# ADMIN_BASIC_AUTH_USERNAME=replace-with-admin-gateway-username
# ADMIN_BASIC_AUTH_PASSWORD=replace-with-long-random-password
# ADMIN_ALLOWED_IPS=203.0.113.10

# Web push (pair with the build-time NEXT_PUBLIC_VAPID_PUBLIC_KEY).
# VAPID_PRIVATE_KEY=replace-with-vapid-private-key
# VAPID_SUBJECT=mailto:operator@example.invalid

# Email delivery: EMAIL_PROVIDER=resend (default rollback path: smtp).
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=replace-with-send-only-key
# EMAIL_FROM=SSARTNERSHIP <auth@example.invalid>
# EMAIL_REPLY_TO=operator@example.invalid
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=sender@example.invalid
# SMTP_PASS=replace-with-smtp-password
# SUGGEST_NOTIFY_EMAIL=operator@example.invalid

# Partner billing and business status lookup.
# PARTNER_BILLING_BANK_NAME=replace-with-bank-name
# PARTNER_BILLING_BANK_ACCOUNT=replace-with-account-number
# PARTNER_BILLING_ACCOUNT_HOLDER=replace-with-account-holder
# NTS_BUSINESS_STATUS_SERVICE_KEY=replace-with-data-go-kr-service-key

# Apple Wallet member pass (disabled unless APPLE_WALLET_ENABLED=true).
# APPLE_WALLET_ENABLED=false
# APPLE_WALLET_TEAM_ID=ABCD123456
# APPLE_WALLET_PASS_TYPE_ID=pass.com.example.member
# APPLE_WALLET_ORGANIZATION_NAME=replace-with-organization-name
# APPLE_WALLET_CERTIFICATE_BASE64=replace-with-base64-pass-type-id-certificate-pem
# APPLE_WALLET_PRIVATE_KEY_BASE64=replace-with-base64-private-key-pem
# APPLE_WALLET_PRIVATE_KEY_PASSPHRASE=
# APPLE_WALLET_WWDR_CERTIFICATE_BASE64=replace-with-base64-wwdr-certificate-pem
# APPLE_WALLET_DEVICE_TOKEN_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key

# Self-hosted Web Vitals collector token. Compose and the monitoring overlay
# inject the self-host mode and the collector switch; do not set them here.
# SELF_HOST_VITALS_TOKEN=replace-with-at-least-32-random-characters
# SELF_HOST_VITALS_SAMPLE_RATE=0.1
