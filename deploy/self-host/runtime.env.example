# Copy this file to deploy/self-host/runtime.env, replace every placeholder,
# and restrict its permissions. The copied runtime.env is ignored by Git.
#
# These public values are build arguments and MUST exactly match the image's
# build manifest. They are intentionally not secrets.
NEXT_PUBLIC_DATA_SOURCE=supabase
NEXT_PUBLIC_PARTNER_PORTAL_DATA_SOURCE=supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:58000
NEXT_PUBLIC_SITE_URL=https://app.example.invalid
# Leave empty only when browser push is intentionally disabled at build time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Self-hosted real mode validates all fields below before starting Next.
# SUPABASE_URL is the externally reachable origin used by the Supabase SDK.
# It MUST equal NEXT_PUBLIC_SUPABASE_URL so generated Storage signed URLs stay
# browser-reachable. SUPABASE_INTERNAL_URL is optional and only routes server
# SDK fetches through the private Compose gateway.
SUPABASE_URL=http://127.0.0.1:58000
SUPABASE_INTERNAL_URL=http://gateway:8000
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
USER_SESSION_SECRET=replace-with-at-least-32-random-characters
PARTNER_SESSION_SECRET=replace-with-at-least-32-random-characters
CERTIFICATION_QR_SECRET=replace-with-at-least-32-random-characters
MEMBER_IDENTIFIER_RESERVATION_HMAC_SECRET=replace-with-at-least-32-random-characters
MEMBER_EMAIL_VERIFICATION_HMAC_SECRET=replace-with-at-least-32-random-characters
GRADUATE_VERIFICATION_HMAC_SECRET=replace-with-at-least-32-random-characters
MM_BASE_URL=https://mattermost.example.invalid
MM_SENDER_CREDENTIALS_ACTIVE_KEY_VERSION=1
# Exactly 32 decoded bytes; standard base64 and base64url are both accepted.
MM_SENDER_CREDENTIALS_KEY_V1=replace-with-32-byte-base64-key
CRON_SECRET=replace-with-at-least-32-random-characters
