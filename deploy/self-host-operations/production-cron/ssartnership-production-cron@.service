[Unit]
Description=SSARTNERSHIP Production scheduled job %i
After=network-online.target docker.service
ConditionPathExists=/etc/myknow/secrets/ssartnership-production/cron-owner
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/flock --wait 120 /run/lock/ssartnership-production-cron.lock /opt/ssartnership/node24/node /opt/ssartnership/production-cron/current/scripts/self-host-operations/production-cron.mjs %i
TimeoutStartSec=150
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/lock
CapabilityBoundingSet=
MemoryMax=128M
CPUQuota=50%
