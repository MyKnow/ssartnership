[Unit]
Description=SSARTNERSHIP Production scheduled job failure notification
After=network-online.target
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/opt/ssartnership/node24/node /opt/ssartnership/production-cron/current/scripts/self-host-operations/notify-cron-failure.mjs %i
TimeoutStartSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
