[Unit]
Description=SSARTNERSHIP encrypted Production backup copy
Wants=network-online.target
After=network-online.target tailscaled.service
RequiresMountsFor=/mnt/ssartnership-backups
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/ssartnership-backup-pull.py
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/ssartnership-backups
CapabilityBoundingSet=
MemoryMax=192M
CPUQuota=50%
TimeoutStartSec=25min
