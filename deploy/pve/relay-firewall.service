[Unit]
Description=SSARTNERSHIP private relay ingress rules
Before=docker.service
# The rules resolve the operations VM route; wait for configured addresses
# and routes instead of racing early boot networking.
After=network-online.target
Wants=network-online.target
# Bound retries to about ten attempts within two minutes, then stay failed.
# docker.service requires this unit, so containers never start without the
# relay rules.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=5
User=root
UMask=0077
EnvironmentFile=/etc/myknow/secrets/ssartnership-pve-relay.env
ExecStart=/usr/bin/python3 /opt/ssartnership/pve/relay-firewall.py

[Install]
WantedBy=multi-user.target
