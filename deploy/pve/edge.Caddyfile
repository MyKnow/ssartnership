{
	admin off
	# Request metrics are exposed only by the internal scrape listener at the
	# end of this file. Host labels stay off so arbitrary Host headers cannot
	# grow label cardinality.
	metrics
	servers {
		timeouts {
			read_body 70s
			write 70s
			idle 5m
		}
	}
}

# Access logs are JSON on stdout; Docker's bounded local driver rotates them.
# Mask client networks and drop credentials, referrers, redirect targets,
# query strings and one-time token path segments before they are written.
# Supabase clients and operator scripts send keys in the apikey header, and a
# client-sent forwarding header can carry an unmasked address.
(ssartnership_access_log) {
	log {
		output stdout
		format filter {
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>uri regexp "^((?:/api)?/(?:admin|partner)/setup/|/(?:wallet/)?verify/|/api/(?:certification|wallet/apple)/avatar/)[^/?]+|([?]).*$" "${1}${2}redacted"
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Apikey delete
			request>headers>X-Forwarded-For delete
			request>headers>X-Real-Ip delete
			request>headers>Referer delete
			resp_headers>Set-Cookie delete
			resp_headers>Location delete
			wrap json
		}
	}
}

# Shared by the four public app/API origins.
(ssartnership_public_origin) {
	encode zstd gzip
	header X-SSARTNERSHIP-Ingress pve-5202
	# Next already sends HSTS for app pages. The default also covers API and
	# edge-generated responses without duplicating an upstream header.
	header ?Strict-Transport-Security "max-age=63072000; includeSubDomains"
	request_body {
		max_size 64MB
	}
	import ssartnership_access_log
}

# Client address contract: this edge has no trusted_proxies, so Caddy replaces
# any client-supplied X-Forwarded-For with the connection address. X-Real-IP is
# not managed by default and is overwritten here. The relay trusts only this
# edge hop and the app trusts only the first X-Forwarded-For value.
(ssartnership_forwarded_client) {
	header_up X-Real-IP {remote_host}
}

# Cron runs over the app VM loopback and readiness serves the private probe.
# Neither is a public endpoint, so the edge answers a plain 404.
(ssartnership_internal_routes) {
	@internal_only path /api/cron /api/cron/* /api/ready /api/ready/*
	respond @internal_only 404
}

ssartnership.myknow.xyz {
	import ssartnership_public_origin
	import ssartnership_internal_routes
	reverse_proxy 192.168.1.182:3110 {
		import ssartnership_forwarded_client
	}
}

ssartnership-dev.myknow.xyz {
	import ssartnership_public_origin
	import ssartnership_internal_routes
	reverse_proxy 192.168.1.69:3108 {
		import ssartnership_forwarded_client
	}
}

ssartnership-api.myknow.xyz {
	import ssartnership_public_origin
	reverse_proxy 192.168.1.182:8000 {
		import ssartnership_forwarded_client
	}
}

ssartnership-api-dev.myknow.xyz {
	import ssartnership_public_origin
	reverse_proxy 192.168.1.69:8000 {
		import ssartnership_forwarded_client
	}
}

# Both environments share one dashboard with the Production access boundary.
ssartnership-infra-dev.myknow.xyz {
	header ?Strict-Transport-Security "max-age=63072000; includeSubDomains"
	route {
		basic_auth bcrypt infra {
			import /run/production-infra-auth/users
		}
		header Cache-Control "no-store"
		redir https://ssartnership-infra.myknow.xyz{uri} 308
	}
}

ssartnership-infra.myknow.xyz {
	encode zstd gzip
	header ?Strict-Transport-Security "max-age=63072000; includeSubDomains"
	# Read-only PVE observations: only this LAN producer can submit numeric data.
	handle /infra/host-metrics {
		@wrong_host not remote_ip 192.168.1.132
		respond @wrong_host 403
		@wrong_method not method POST
		respond @wrong_method 405
		request_body {
			max_size 4KB
		}
		rewrite * /host-metrics
		reverse_proxy notifier:9465 {
			header_up -Cookie
			header_up -Origin
		}
	}
	@infra path /infra /infra/*
	handle @infra {
		route {
			basic_auth bcrypt infra {
				import /run/production-infra-auth/users
			}
			header Cache-Control "no-store"
			header Referrer-Policy "no-referrer"
			header X-Frame-Options "DENY"
			@cross_site {
				header Sec-Fetch-Site cross-site
				not header Sec-Fetch-Mode navigate
			}
			respond @cross_site 403
			@foreign_origin {
				header Origin *
				not header Origin https://ssartnership-infra.myknow.xyz
			}
			respond @foreign_origin 403
			@unsafe_readonly {
				path /infra/prometheus/* /infra/alertmanager/*
				not method GET HEAD
			}
			respond @unsafe_readonly 405
			redir /infra/prometheus /infra/prometheus/ 308
			redir /infra/alertmanager /infra/alertmanager/ 308
			redir /infra/grafana /infra/grafana/ 308
			handle_path /infra/prometheus/* {
				reverse_proxy prometheus:9090 {
					header_up -Authorization
					header_up -Cookie
					header_down -Access-Control-Allow-Origin
				}
			}
			handle_path /infra/alertmanager/* {
				reverse_proxy alertmanager:9093 {
					header_up -Authorization
					header_up -Cookie
					header_down -Access-Control-Allow-Origin
				}
			}
			handle_path /infra/grafana/* {
				reverse_proxy grafana:3000 {
					header_up -X-WEBAUTH-USER
					header_up -X-WEBAUTH-ROLE
				}
			}
			respond "Infrastructure: /infra/prometheus/ /infra/alertmanager/ /infra/grafana/" 200
		}
	}
	handle {
		redir /infra/prometheus/ 302
	}
}

# ClayFarm was retired on 2026-10-02; keep a terminal response for old clients.
clayfarm.myknow.xyz {
	header Cache-Control "no-store"
	respond "서비스 운영을 종료했습니다." 410
}

malmoa.myknow.xyz {
	encode zstd gzip
	header X-MALMOA-Environment team
	# The guest ingress permits this operations VM and the PVE management host.
	reverse_proxy 192.168.1.78:8080
}
malmoa-preview.myknow.xyz {
	encode zstd gzip
	header X-MALMOA-Environment preview
	reverse_proxy 192.168.1.136:8080
}

# Internal Prometheus scrape listener. Compose publishes only 80/443 for this
# container; the matcher also rejects any non-private source address.
http://:9180 {
	route {
		@external not remote_ip private_ranges
		respond @external 403
		metrics /metrics
		respond 404
	}
}
