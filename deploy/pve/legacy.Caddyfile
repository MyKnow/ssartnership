{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static 192.168.1.2/32
		trusted_proxies_strict
	}
}

# Preserve services whose guests currently admit the laptop ingress only.
# This private listener does not depend on the laptop's public certificates.
http://:9080 {
	@denied not remote_ip 192.168.1.2/32
	respond @denied 403
	@clayfarm host clayfarm.myknow.xyz
	handle @clayfarm {
		request_body {
			max_size 53477376
		}
		reverse_proxy clayfarm-api:8765
	}
	@malmoa host malmoa.myknow.xyz
	handle @malmoa {
		reverse_proxy 192.168.1.78:8080
	}
	@malmoa_preview host malmoa-preview.myknow.xyz
	handle @malmoa_preview {
		reverse_proxy 192.168.1.136:8080
	}
	respond 404
}

http://:19000 {
	respond /health 204
}
