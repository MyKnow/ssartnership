# 전체 목록과 필수/선택/호환/폐기 예정 분류의 정본은 scripts/lib/env-manifest.mjs입니다.
# npm run check:env 로 이 파일·deploy/self-host/runtime.env.example·코드의 drift를 확인합니다.

# Supabase 설정
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 선택 사항: 서버 SDK 전송만 내부 gateway로 보낼 때 (자체 호스팅 Compose)
# SUPABASE_INTERNAL_URL=http://gateway:8000

# 인증 및 세션 (서버 전용, 최소 32자 이상의 난수)
ADMIN_SESSION_SECRET=replace-with-long-random-string
# 선택 사항: 미리보기 링크 전용 암호화 시크릿. 미설정 시 ADMIN_SESSION_SECRET에서 분리 파생합니다.
PARTNER_PREVIEW_TOKEN_ENCRYPTION_SECRET=replace-with-long-random-string
USER_SESSION_SECRET=replace-with-long-random-string
PARTNER_SESSION_SECRET=replace-with-long-random-string
CERTIFICATION_QR_SECRET=replace-with-long-random-string
MEMBER_IDENTIFIER_RESERVATION_HMAC_SECRET=replace-with-at-least-32-random-characters
MEMBER_EMAIL_VERIFICATION_HMAC_SECRET=replace-with-at-least-32-random-characters
GRADUATE_VERIFICATION_HMAC_SECRET=replace-with-at-least-32-random-characters
# 선택 사항: 용도별 분리 비밀. 미설정 시 USER_SESSION_SECRET으로 대체합니다.
# RESET_PASSWORD_SESSION_SECRET=replace-with-at-least-32-random-characters
# MANUAL_MEMBER_IMPORT_TOKEN_SECRET=replace-with-at-least-32-random-characters
# 선택 사항: 관리자 세션 시간(1~24, 기본 12)
# ADMIN_SESSION_TTL_HOURS=12

# 관리자 엣지 보호: /admin을 공개하기 전에 운영 환경에 설정합니다.
ADMIN_BASIC_AUTH_USERNAME=replace-with-admin-gateway-username
ADMIN_BASIC_AUTH_PASSWORD=replace-with-long-random-password
# 선택 사항: 쉼표로 구분한 관리자 허용 IP. 신뢰 프록시 IP 계약이 성립한 환경에서만 설정합니다.
# ADMIN_ALLOWED_IPS=203.0.113.10

# Mattermost 직접 발신자 레지스트리 (서버 전용)
# 키는 정확히 32바이트 난수를 Base64 형식으로 인코딩한 값이어야 합니다.
# 발신자 로그인 식별자와 비밀번호는 최고 관리자가 /admin/cycle에서 입력합니다.
MM_BASE_URL=https://mattermost.example.com
MM_SENDER_CREDENTIALS_ACTIVE_KEY_VERSION=1
MM_SENDER_CREDENTIALS_KEY_V1=replace-with-32-byte-base64-key

# 파트너 청구 및 사업자 상태 조회
PARTNER_BILLING_BANK_NAME=은행명
PARTNER_BILLING_BANK_ACCOUNT=000-000000-00-000
PARTNER_BILLING_ACCOUNT_HOLDER=예금주명
NTS_BUSINESS_STATUS_SERVICE_KEY=your-data-go-kr-service-key

# 이메일 발송
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace-with-send-only-key
EMAIL_FROM="싸트너십 <auth@ssartnership.myknow.xyz>"
EMAIL_REPLY_TO=myknow@ssafy.com
# SMTP 롤백 시 EMAIL_PROVIDER=smtp로 바꾸고 아래 서버 전용 값을 사용합니다.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@example.com
SMTP_PASS=your-smtp-password
SUGGEST_NOTIFY_EMAIL=operator@example.com

# 웹 푸시 및 예약 작업
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:operator@example.com
CRON_SECRET=replace-with-long-random-string

# 공개 사이트 주소
NEXT_PUBLIC_SITE_URL=https://ssartnership.myknow.xyz

# 자체 호스팅 Web Vitals (monitoring overlay가 SELF_HOST_VITALS_ENABLED=1을 설정할 때만 사용)
# SELF_HOST_VITALS_TOKEN=replace-with-at-least-32-random-characters
# SELF_HOST_VITALS_SAMPLE_RATE=0.1

# Apple Wallet 멤버 패스 (서버 전용)
# APPLE_WALLET_ENABLED=true 일 때만 발급을 활성화합니다.
# 인증서 값은 PEM 원문을 Base64로 인코딩한 문자열이어야 합니다.
# APPLE_WALLET_ENABLED=true이면 NEXT_PUBLIC_SITE_URL을 명시해야 합니다.
APPLE_WALLET_ENABLED=false
APPLE_WALLET_TEAM_ID=ABCD123456
APPLE_WALLET_PASS_TYPE_ID=pass.com.example.ssartnership.member
APPLE_WALLET_ORGANIZATION_NAME=싸트너십
APPLE_WALLET_CERTIFICATE_BASE64=replace-with-base64-pass-type-id-certificate-pem
APPLE_WALLET_PRIVATE_KEY_BASE64=replace-with-base64-private-key-pem
APPLE_WALLET_PRIVATE_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_CERTIFICATE_BASE64=replace-with-base64-wwdr-certificate-pem
# 정확히 32바이트 난수를 Base64로 인코딩한 Wallet master key입니다.
# APNs push token 암호화와 device ID hash, ApplePass 인증, QR 서명은 각각 용도 분리된 HMAC subkey를 사용합니다.
# 설치된 pass와 저장 데이터의 마이그레이션·재발급 계획 없이 이 키를 회전하지 마세요.
APPLE_WALLET_DEVICE_TOKEN_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key

# 데이터 소스 (supabase 또는 mock). 로컬 촬영용 mock 데모는 둘 다 mock으로 둡니다.
# NEXT_PUBLIC_DATA_SOURCE=mock
# NEXT_PUBLIC_PARTNER_PORTAL_DATA_SOURCE=mock
# MOCK_MEMBER_AUTH=1
# MOCK_ID=myknow
# MOCK_PW=replace-with-local-demo-password
# MOCK_MEMBER_PROFILE_IMAGE_URL=/mock/members/jung-minho.jpg
# E2E 전용 스위치 (Playwright mock 런타임에서만 사용)
# E2E_ADMIN_AUTH=1
# E2E_MOCK_MUTATIONS=1

# Supabase transport timeouts (milliseconds)
SUPABASE_FETCH_TIMEOUT_MS=30000
SUPABASE_STORAGE_FETCH_TIMEOUT_MS=60000
